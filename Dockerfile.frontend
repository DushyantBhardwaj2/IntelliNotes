# IntelliNotes frontend — Streamlit UI talking to the backend over HTTP.
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /srv

COPY frontend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY frontend/app.py ./app.py

# API_BASE must point at the reachable backend URL (compose sets it to the
# backend service; hosted platforms set it to the public backend URL).
ENV API_BASE=http://backend:8000
EXPOSE 8501

CMD ["streamlit", "run", "app.py", "--server.port=8501", "--server.address=0.0.0.0", "--server.headless=true"]

# Get your Gemini key at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-gemini-api-key-here

# Get your Tavily key at: https://app.tavily.com (free tier: 1000 credits/month)
TAVILY_API_KEY=your-tavily-api-key-here

# Optional: override the chat model (default: gemini-3.5-flash-lite).
# Free tier allows ~20 requests/day PER MODEL, so switching models gives
# you a fresh quota bucket. Available: gemini-3.5-flash, gemini-3.6-flash,
# gemini-3.7-flash, gemini-flash-latest, ...
# CHAT_MODEL=gemini-3.6-flash

[TEMPLATE]
# Get your Gemini key at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-gemini-api-key-here

# Get your Tavily key at: https://app.tavily.com (free tier: 1000 credits/month)
TAVILY_API_KEY=your-tavily-api-key-here

# Optional: override the chat model (default: gemini-3.5-flash-lite).
# Free tier allows ~20 requests/day PER MODEL, so switching models gives
# you a fresh quota bucket. Available: gemini-3.5-flash, gemini-3.6-flash,
# gemini-3.7-flash, gemini-flash-latest, ...
# CHAT_MODEL=gemini-3.6-flash

# ---------------------------------------------------------------------------
# Deployment hardening (all optional; defaults are local-dev friendly)
# ---------------------------------------------------------------------------
# Shared secret for the API. When set, /chat/, /upload-document/ and the
# DELETE /documents endpoints require the "X-API-Key" header.
# The Streamlit frontend sends INTELLINOTES_API_KEY as that header.
# API_KEY=change-me-to-a-long-random-string

# Comma-separated browser origins allowed to call the API (CORS).
# Defaults to http://localhost:8501 + http://127.0.0.1:8501 when unset.
# Use "*" ONLY for local experimentation.
# CORS_ORIGINS=https://your-app.streamlit.app

# Per-minute request limits per caller (0 disables the limiter).
# RATE_LIMIT_CHAT=10/minute
# RATE_LIMIT_UPLOAD=5/minute

# Where ChromaDB + SQLite state lives. Set this to your host's mounted
# volume path (e.g. /data) or uploads and conversations vanish on restart.
# DATA_DIR=/data

# Keep-alive self-ping configuration (prevents free-tier hosts like Render from sleeping)
# Defaults to true; automatically targets RENDER_EXTERNAL_URL/ping when deployed on Render.
# KEEP_ALIVE_ENABLED=true
# KEEP_ALIVE_INTERVAL_MINUTES=10
# KEEP_ALIVE_URL=https://intellinotes-backend.onrender.com/ping
